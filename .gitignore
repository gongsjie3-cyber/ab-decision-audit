# ---- 数据：不要把原始数据提交进仓库 ----
# 用 scripts/fetch_data.py 下载（含 sha256 校验），共约 28 MB
data/raw/*.csv
data/raw/*.zip

# 派生数据可由 python -m src.run_all 在 30 秒内完整重建，不提交以保持仓库轻量
data/processed/*.csv.gz
data/processed/*.parquet

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# Word 版报告：本地保留但不提交（GitHub 无法预览 .docx，点击只会触发下载；
# 用 python -m src.make_report_docx 可随时重新生成）
reports/report.docx

# ---- 运行产物 ----
.mplcache/
*.log
.DS_Store
.idea/
.vscode/
